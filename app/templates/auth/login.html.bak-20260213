<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>تسجيل الدخول - نظام إدارة الموارد البشرية</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        :root{--brand:#0d6efd;--glass:rgba(255,255,255,0.06);--card-bg:rgba(255,255,255,0.95)}
        html,body{height:100%;}
        body {
            font-family: 'Cairo', sans-serif;
            margin:0;
            background: radial-gradient( circle at 10% 20%, rgba(13,110,253,0.06), transparent 10% ),
                        radial-gradient( circle at 90% 80%, rgba(255,193,7,0.04), transparent 10% ),
                        linear-gradient(135deg,#071426 0%, #0b2540 100%);
            color: #f8f9fa;
            display:flex;
            align-items:center;
            justify-content:center;
            overflow:hidden;
        }
        /* subtle moving glow */
        .bg-animate{position:absolute;inset:0;pointer-events:none;opacity:0.35;background:linear-gradient(120deg, rgba(255,255,255,0.02), rgba(255,255,255,0));transform:skewY(-6deg);animation:floatBG 8s ease-in-out infinite}
        @keyframes floatBG{0%{transform:translateY(0) skewY(-6deg)}50%{transform:translateY(-20px) skewY(-6deg)}100%{transform:translateY(0) skewY(-6deg)}}

        .neon-card{
            width:100%;max-width:430px;padding:2.2rem;border-radius:14px;background:linear-gradient(180deg, rgba(255,255,255,0.04), rgba(255,255,255,0.02));backdrop-filter: blur(6px);box-shadow:0 10px 30px rgba(2,6,23,0.6);position:relative;border:1px solid rgba(255,255,255,0.06);
        }
        .neon-card:before,.neon-card:after{content:'';position:absolute;inset:-2px;border-radius:16px;padding:2px;background:linear-gradient(90deg, rgba(13,110,253,0.6), rgba(255,193,7,0.35));filter:blur(12px);opacity:0;transition:opacity .3s;pointer-events:none}
        .neon-card:hover:before,.neon-card:hover:after{opacity:1}

        .brand{display:flex;align-items:center;gap:.8rem;justify-content:center;margin-bottom:1rem}
        .brand .logo{width:56px;height:56px;border-radius:10px;background:linear-gradient(135deg,var(--brand),#6c63ff);box-shadow:0 6px 20px rgba(12,100,255,0.25);display:flex;align-items:center;justify-content:center;font-weight:700;color:#fff;font-size:18px}
        .brand h2{margin:0;font-size:1.25rem;color:#fff;font-weight:700}
        .brand p{margin:0;color:rgba(255,255,255,0.75)}

        .form-control{background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.08);color:#fff;padding:.8rem;border-radius:8px}
        .form-control:focus{box-shadow:0 0 0 4px rgba(13,110,253,0.12);border-color:var(--brand);outline:none}
        label.form-label{color:rgba(255,255,255,0.8)}

        .btn-login{background:linear-gradient(90deg,var(--brand),#6c63ff);border:0;color:#fff;padding:.75rem;border-radius:10px;width:100%;font-weight:700;box-shadow:0 8px 20px rgba(12,100,255,0.25);transition:transform .15s}
        .btn-login:active{transform:translateY(1px)}

        .muted{color:rgba(255,255,255,0.6);font-size:.95rem;text-align:center;margin-top:.75rem}

        /* small animated accent lines */
        .accent-line{position:absolute;height:2px;width:60%;left:20%;top:6%;background:linear-gradient(90deg, rgba(13,110,253,0.9), rgba(108,99,255,0.6));filter:blur(6px);opacity:.7;transform-origin:left;animation:lineMove 3s linear infinite;pointer-events:none}
        .accent-line.two{top:auto;bottom:6%;animation-duration:4s;animation-direction:reverse}
        @keyframes lineMove{0%{transform:scaleX(0)}50%{transform:scaleX(1)}100%{transform:scaleX(0)}}

        /* small screens */
        @media(max-width:480px){.neon-card{padding:1.4rem;border-radius:12px}.brand h2{font-size:1rem}.brand .logo{width:48px;height:48px}}
    </style>
</head>
<body>

<div class="neon-card">
    <div class="accent-line"></div>
    <div class="accent-line two"></div>













































</html></body></div>    <p class="muted">ليس لديك حساب؟ تواصل مع مسؤول النظام</p>    </form>        <button type="submit" class="btn-login">دخول</button>        </div>            <a href="#" class="text-decoration-none text-white-50 small">نسيت كلمة المرور؟</a>            </div>                <label class="form-check-label text-white-50" for="remember">تذكرني</label>                <input class="form-check-input" type="checkbox" value="1" id="remember" name="remember">            <div class="form-check">        <div class="d-flex justify-content-between align-items-center mb-3">        </div>            <input type="password" class="form-control" id="password" name="password" required>            <label for="password" class="form-label">كلمة المرور</label>        <div class="mb-3">        </div>            <input type="text" class="form-control" id="username" name="username" required autofocus>            <label for="username" class="form-label">اسم المستخدم</label>        <div class="mb-3">        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">    <form method="POST">    {% endwith %}      {% endif %}        {% endfor %}          {% endif %}            <div class="alert alert-{{ category }}">{{ message }}</div>          {% if category not in ['success','danger','error','center'] %}          {# keep inline alerts for non-success/error types; success/error handled globally by base.html flash -> modal #}        {% for category, message in messages %}      {% if messages %}
n    {% with messages = get_flashed_messages(with_categories=true) %}    </div>        </div>            <p class="muted">تسجيل الدخول الآمن</p>            <h2>نظام الموارد البشرية</h2>        <div>        <div class="logo">HR</div>n    <div class="brand">