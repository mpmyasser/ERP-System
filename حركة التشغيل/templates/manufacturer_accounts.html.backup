{% extends "base.html" %}

{% block title %}حسابات المصنعين{% endblock %}

{% block content %}
<div class="compact-report shadow-sm mb-3">
    <div class="compact-report-title">تقرير سريع</div>
    <div class="compact-report-items">
        <div class="compact-report-item">
            <span class="compact-report-label">عدد الرسائل</span>
            <span class="compact-report-value" id="quickReportMessages">0</span>
        </div>
        <div class="compact-report-item">
            <span class="compact-report-label">عدد الأصناف</span>
            <span class="compact-report-value" id="quickReportItems">0</span>
        </div>
        <div class="compact-report-item">
            <span class="compact-report-label">مجموع الكميات</span>
            <span class="compact-report-value" id="quickReportQuantity">0.00</span>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">

    <div class="card-header bg-white">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <div class="d-flex gap-3 align-items-center">
                <div>
                    <div class="text-muted small">حسابات المصنعين</div>
                    <h5 class="mb-0">{% if current_view == 'history' %}أرشيف القصات المحاسب عليها{% else %}القصات التي تم تسليمها للمصانع{% endif %}</h5>
                </div>
                <div class="btn-group btn-group-sm ms-3">
                    <a href="{{ url_for('manufacturer_accounts_page', view='pending') }}" class="btn btn-outline-primary {% if current_view != 'history' %}active{% endif %}">بانتظار المحاسبة</a>
                    <a href="{{ url_for('manufacturer_accounts_page', view='history') }}" class="btn btn-outline-primary {% if current_view == 'history' %}active{% endif %}">الأرشيف</a>
                </div>
            </div>
            <div class="col-lg-5 d-flex gap-2">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" class="form-control" id="manufacturerSearchInput" placeholder="ابحث بالرسالة أو الصنف أو المصنع">
                    <button type="button" class="btn btn-outline-secondary" id="manufacturerSearchClearButton">مسح</button>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm text-nowrap" id="togglePrintColumnsButton">
                    <i class="fas fa-print me-1"></i> إعدادات الطباعة
                </button>
                <button type="button" class="btn btn-outline-primary btn-sm text-nowrap" id="printManualTableButton">
                    <i class="fas fa-print me-1"></i> طباعة
                </button>
            </div>

        </div>
    </div>
    <div class="print-columns-panel d-none p-3 border-bottom bg-light" id="printColumnsPanel">
        <div class="row">
            <div class="col-md-8">
                <div class="small fw-bold mb-2 text-primary"><i class="fas fa-columns me-1"></i> تخصيص أعمدة الطباعة:</div>
                <div id="printColumnsOptions" class="row g-2"></div>
                <div class="mt-2 d-flex gap-2">
                    <button type="button" class="btn btn-light btn-sm btn-select-all border">تحديد الكل</button>
                    <button type="button" class="btn btn-light btn-sm btn-clear-all border">إلغاء الكل</button>
                </div>
            </div>
            <div class="col-md-4 border-start">
                <div class="mb-3">
                    <div class="small fw-bold mb-2 text-primary"><i class="fas fa-heading me-1"></i> رأس الصفحة:</div>
                    <div class="d-flex gap-2">
                        <input type="text" class="form-control form-control-sm" id="printHeaderNoteInput"
                            placeholder="أدخل عنواناً يظهر في أعلى الورقة">
                        <button type="button" class="btn btn-primary btn-sm text-nowrap" id="savePrintHeaderBtn">
                            <i class="fas fa-save me-1"></i> حفظ
                        </button>
                    </div>
                </div>
                <div>
                    <div class="small fw-bold mb-2 text-primary"><i class="fas fa-align-left me-1"></i> تذييل الصفحة:</div>
                    <div class="d-flex gap-2">
                        <input type="text" class="form-control form-control-sm" id="printFooterNoteInput"
                            placeholder="أدخل نصاً يظهر في أسفل الورقة">
                        <button type="button" class="btn btn-primary btn-sm text-nowrap" id="savePrintFooterBtn">
                            <i class="fas fa-save me-1"></i> حفظ
                        </button>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="form-check form-switch form-check-inline">
                        <input class="form-check-input" type="checkbox" id="printShowTimeCheck" checked>
                        <label class="form-check-label small" for="printShowTimeCheck">إظهار وقت الطباعة</label>
                    </div>
                    <div class="form-check form-switch form-check-inline">
                        <input class="form-check-input" type="checkbox" id="printShowPageNumbersCheck" checked>
                        <label class="form-check-label small" for="printShowPageNumbersCheck">ترقيم الصفحات</label>
                    </div>
                </div>
                <div class="small text-muted mt-2">تحل هذه الملاحظات محل روابط المتصفح التلقائية.</div>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="alert d-flex align-items-center small m-3" id="pageMessage" role="alert"></div>
        <div class="table-responsive" style="max-height: 70vh; overflow:auto;">
            <table class="table table-sm table-striped mb-0" id="manufacturerCutsTable" data-resize-key="cuts-manufacturers-page">
                <thead class="table-light" style="position: sticky; top: 0; z-index: 2;">
                    <tr>
                        <th style="width: 40px;"><input type="checkbox" id="selectAllItems" class="form-check-input"></th>
                        <th>تاريخ القص</th>
                        <th>رقم الرسالة</th>
                        <th>الكود</th>
                        <th>الاسم</th>
                        <th>المقاس</th>
                        <th>الكمية</th>
                        <th>الوصف</th>
                        <th>كود المصنع</th>
                        <th>اسم المصنع</th>
                        <th>سعر الدستة</th>
                        <th>تاريخ التسليم</th>
                        <th>الحالة</th>
                        <th data-print="no">الإجراءات</th>
                    </tr>
                </thead>
                <tbody id="manufacturerCutsTableBody">
                    {% if current_view == 'history' %}
                        {% if grouped_statements %}
                        {% for stmt in grouped_statements %}
                        <tr class="table-success-subtle">
                            <td><i class="fas fa-archive text-success opacity-50"></i></td>
                            <td class="fw-bold font-monospace">{{ stmt.accounting_id }}</td>
                            <td colspan="5">
                                <div><span class="badge text-bg-primary fs-6">{{ stmt.factory_name }}</span> | تاريخ التسوية: {{ stmt.accounted_date }}</div>
                                <div class="small text-muted mt-1">إجمالي: {{ stmt.total_items }} قصة، بـكمية {{ stmt.total_quantity }}</div>
                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td><div class="fw-bold fs-6 text-success">{{ "%.2f"|format(stmt.total_amount) }} ج.م</div></td>
                            <td></td>
                            <td>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-primary print-stmt-btn" data-id="{{ stmt.accounting_id }}" title="طباعة كشف الحساب/الإيصال"><i class="fas fa-print"></i> طباعة</button>
                                    <button type="button" class="btn btn-sm btn-outline-danger reverse-stmt-btn" data-id="{{ stmt.accounting_id }}" title="إلغاء وفك التسوية"><i class="fas fa-undo-alt"></i></button>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                        {% else %}
                        <tr>
                            <td colspan="14" class="text-center text-muted p-5">
                                <i class="fas fa-archive fs-1 mb-3 opacity-25"></i>
                                <h5>لا توجد تسويات مؤرشفة</h5>
                            </td>
                        </tr>
                        {% endif %}
                    {% else %}
                        {% if manufacturer_cut_items %}
                        {% for item in manufacturer_cut_items %}
                        <tr data-item-id="{{ item.id }}" class="{% if item.is_accounted %}table-success-subtle{% endif %}">
                            <td><input type="checkbox" class="form-check-input item-checkbox" data-id="{{ item.id }}"></td>
                            <td><input type="text" class="form-control form-control-sm recent-cut-date recent-basic-field date-input" value="{{ item.cut_date or '' }}" readonly></td>
                            <td><input type="text" class="form-control form-control-sm recent-message-no recent-basic-field" value="{{ item.message_no or '' }}" readonly></td>
                            <td><input type="text" class="form-control form-control-sm recent-code recent-basic-field" value="{{ item.code or '' }}" readonly></td>
                            <td><input type="text" class="form-control form-control-sm recent-name recent-basic-field" value="{{ item.name or '' }}" readonly></td>
                            <td><input type="text" class="form-control form-control-sm recent-size recent-basic-field" value="{{ item.size or '' }}" readonly></td>
                            <td><input type="number" class="form-control form-control-sm recent-quantity recent-basic-field" value="{{ item.quantity or 0 }}" min="0" step="0.01" readonly></td>
                            <td><input type="text" class="form-control form-control-sm recent-description recent-basic-field" value="{{ item.description or '' }}" readonly></td>
                            <td><input type="text" class="form-control form-control-sm recent-factory-code recent-dispatch-field" value="{{ item.factory_code or '' }}"></td>
                            <td><input type="text" class="form-control form-control-sm recent-factory-name recent-dispatch-field" value="{{ item.factory_name or '' }}" list="factoryNamesList"></td>
                            <td><input type="number" class="form-control form-control-sm recent-manufacturing-price recent-dispatch-field" value="{{ item.manufacturing_price if item.manufacturing_price else '' }}" min="0" step="0.01"></td>
                            <td><input type="text" class="form-control form-control-sm recent-dispatch-date recent-dispatch-field date-input" value="{{ item.dispatch_date or '' }}" placeholder="dd/mm/yyyy"></td>
                            <td>
                                <span class="badge recent-status {{ 'text-bg-success' if item.status == 'تم الاستلام' else 'text-bg-info' }}">{{ item.status }}</span>
                            </td>
                            <td data-print="no">
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-primary edit-recent-item" title="تعديل"><i class="fas fa-edit"></i></button>
                                    <button type="button" class="btn btn-sm btn-outline-success save-recent-item" title="حفظ"><i class="fas fa-save"></i></button>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                        {% else %}
                        <tr>
                            <td colspan="14" class="text-center text-muted p-4">لا توجد سجلات بانتظار المحاسبة.</td>
                        </tr>
                        {% endif %}
                    {% endif %}
                    <tr id="manufacturerSearchEmptyRow" class="d-none">
                        <td colspan="14" class="text-center text-muted p-4">لا توجد نتائج مطابقة للبحث.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="selectionSummaryBar" class="bg-primary text-white p-2 px-3 d-none animate__animated animate__fadeInUp" style="position: sticky; bottom: 0; z-index: 1000; border-radius: 8px 8px 0 0;">
            <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center">
                <div class="d-flex gap-4 align-items-center">
                    <div class="fw-bold"><i class="fas fa-check-square me-1"></i> المختارات: <span id="selectedCount">0</span></div>
                    <div>إجمالي الكميات: <span id="selectedQuantity">0</span></div>
                    <div class="fs-5">إجمالي المبلغ: <span id="selectedTotalPrice" class="fw-bold">0.00</span> ج.م</div>
                </div>
                <!-- رصيد السلف الحالي -->
                <div class="d-flex gap-2 align-items-center bg-white bg-opacity-10 p-2 px-3 rounded-3">
                    <div class="small text-white-50">رصيد السلف الحالي:</div>
                    <div class="fw-bold fs-6"><span id="currentFactoryBalance">0.00</span> ج.م</div>
                </div>
                <!-- الحسابات المتقدمة -->
                <div class="d-flex gap-3 align-items-center bg-white bg-opacity-10 p-2 px-3 rounded-3">
                    <div class="small">الخصم من السلف:</div>
                    <input type="number" class="form-control form-control-sm" id="deductionAmount" placeholder="0.00" style="width: 100px;">
                    <div class="fw-bold border-start ps-3 ms-2">الصافي نقداً: <span id="netToPay" class="text-warning">0.00</span> ج.م</div>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <button type="button" class="btn btn-warning btn-sm fw-bold border-0 text-dark" id="quickReportBtn">
                        <i class="fas fa-file-invoice me-1"></i> تقرير سريع
                    </button>
                    <input type="text" class="form-control form-control-sm date-input" id="accountingDate" value="{{ current_time.strftime('%d/%m/%Y') }}" style="width: 120px;">

                    <button type="button" class="btn btn-light btn-sm fw-bold" id="confirmAccountingButton">
                        <i class="fas fa-coins me-1"></i> تأكيد المحاسبة (ترقية للأرشيف)
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Report Modal -->
<div class="modal fade" id="quickReportModal" tabindex="-1" aria-labelledby="quickReportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-warning border-0 p-3">
                <h5 class="modal-title fw-bold" id="quickReportModalLabel"><i class="fas fa-file-invoice me-2"></i>معاينة التقرير السريع (قبل التأكيد)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="quickReportContent">
                <!-- Content will be injected by JS -->
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 p-3 bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">إغلاق</button>
                <button type="button" class="btn btn-primary px-4 fw-bold" id="printQuickReportBtn">
                    <i class="fas fa-print me-1"></i> طباعة التقرير
                </button>
            </div>
        </div>
    </div>
</div>


<datalist id="factoryNamesList">
    {% for factory in factories %}
    <option value="{{ factory.name }}" data-code="{{ factory.code }}">{{ factory.code }}</option>
    {% endfor %}
</datalist>
{% endblock %}

{% block scripts %}
<script>

    (function () {
        const messageBox = document.getElementById('pageMessage');
        const table = document.getElementById('manufacturerCutsTable');
        const tableBody = document.getElementById('manufacturerCutsTableBody');
        const factoryList = document.getElementById('factoryNamesList');
        const searchInput = document.getElementById('manufacturerSearchInput');
        const searchClearButton = document.getElementById('manufacturerSearchClearButton');
        const emptyRow = document.getElementById('manufacturerSearchEmptyRow');
        const selectAllCheckbox = document.getElementById('selectAllItems');
        const selectionSummaryBar = document.getElementById('selectionSummaryBar');
        const selectedCountEl = document.getElementById('selectedCount');
        const selectedQuantityEl = document.getElementById('selectedQuantity');
        const selectedTotalPriceEl = document.getElementById('selectedTotalPrice');
        const deductionAmountInput = document.getElementById('deductionAmount');
        const netToPayEl = document.getElementById('netToPay');
        const currentFactoryBalanceEl = document.getElementById('currentFactoryBalance');
        const confirmButton = document.getElementById('confirmAccountingButton');
        const accountingDateInput = document.getElementById('accountingDate');


        function showMessage(message, type) {
            if (!messageBox) return;
            messageBox.className = `alert alert-${type} d-flex align-items-center small m-3`;
            messageBox.textContent = message;
        }

        function reloadPage(message) {
            showMessage(message, 'success');
            window.setTimeout(() => window.location.reload(), 350);
        }

        function buildSearchText(row) {
            return [
                row.querySelector('.recent-message-no')?.value || '',
                row.querySelector('.recent-code')?.value || '',
                row.querySelector('.recent-name')?.value || '',
                row.querySelector('.recent-factory-code')?.value || '',
                row.querySelector('.recent-factory-name')?.value || ''
            ].join(' ').toLowerCase();
        }

        // ─── إعدادات الطباعة: تحميل قيمة التذييل عند فتح اللوحة ───────────────
        const togglePrintColumnsButton = document.getElementById('togglePrintColumnsButton');
        const printColumnsPanel        = document.getElementById('printColumnsPanel');
        const printHeaderNoteInput     = document.getElementById('printHeaderNoteInput');
        const printFooterNoteInput     = document.getElementById('printFooterNoteInput');
        const savePrintHeaderBtn       = document.getElementById('savePrintHeaderBtn');
        const savePrintFooterBtn       = document.getElementById('savePrintFooterBtn');

        // تحميل النصوص المحفوظة عند فتح اللوحة
        togglePrintColumnsButton?.addEventListener('click', async () => {
            const isHidden = printColumnsPanel.classList.contains('d-none');
            printColumnsPanel?.classList.toggle('d-none');
            
            if (isHidden) {
                try {
                    const [hResp, fResp] = await Promise.all([
                        fetch('/api/settings?key=statement_header_note').then(r => r.json()),
                        fetch('/api/settings?key=statement_footer_note').then(r => r.json())
                    ]);
                    if (printHeaderNoteInput) printHeaderNoteInput.value = hResp.value || '';
                    if (printFooterNoteInput) printFooterNoteInput.value = fResp.value || '';
                } catch (_) {}
            }
        });

        async function saveSetting(key, value, button) {
            button.disabled = true;
            const originalHtml = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>';
            try {
                const response = await fetch('/api/settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ key: key, value: value.trim() })
                });
                const result = await response.json();
                if (result.ok) {
                    button.innerHTML = '<i class="fas fa-check"></i>';
                    setTimeout(() => button.innerHTML = originalHtml, 2000);
                } else {
                    throw new Error(result.message);
                }
            } catch (error) {
                showMessage('حدث خطأ: ' + error.message, 'danger');
                button.innerHTML = originalHtml;
            } finally {
                button.disabled = false;
            }
        }

        savePrintHeaderBtn?.addEventListener('click', () => saveSetting('statement_header_note', printHeaderNoteInput.value, savePrintHeaderBtn));
        savePrintFooterBtn?.addEventListener('click', () => saveSetting('statement_footer_note', printFooterNoteInput.value, savePrintFooterBtn));

        const applySearch = () => {
            const query = (searchInput?.value || '').trim().toLowerCase();
            const terms = query.split(/\s+/).filter(Boolean);
            const rows = Array.from(tableBody.querySelectorAll('tr[data-item-id]'));
            let visibleCount = 0;
            
            // Dashboard Totals
            const uniqueMessages = new Set();
            let totalItems = 0;
            let totalQty = 0;

            rows.forEach((row) => {
                const haystack = buildSearchText(row);
                const matches = !terms.length || terms.every((term) => haystack.includes(term));
                row.classList.toggle('d-none', !matches);
                if (matches) {
                    visibleCount += 1;
                    
                    // Accumulate totals
                    const msgNo = row.querySelector('.recent-message-no')?.value || '';
                    if (msgNo) uniqueMessages.add(msgNo);
                    totalItems++;
                    const qty = parseFloat(row.querySelector('.recent-quantity')?.value || 0);
                    totalQty += qty;
                }
            });

            // Update Dashboard
            const dashMessages = document.getElementById('quickReportMessages');
            const dashItems = document.getElementById('quickReportItems');
            const dashQuantity = document.getElementById('quickReportQuantity');

            if (dashMessages) dashMessages.textContent = uniqueMessages.size;
            if (dashItems) dashItems.textContent = totalItems;
            if (dashQuantity) dashQuantity.textContent = totalQty.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            const searchEmptyRow = document.getElementById('manufacturerSearchEmptyRow');
            if (searchEmptyRow) {
                searchEmptyRow.classList.toggle('d-none', visibleCount !== 0 || !rows.length);
            }
            
            updateSelectAllState();
            updateSelectionSummary();
        }

        function updateSelectAllState() {
            if (!selectAllCheckbox) return;
            const visibleCheckboxes = Array.from(tableBody.querySelectorAll('tr:not(.d-none) .item-checkbox'));
            if (!visibleCheckboxes.length) {
                selectAllCheckbox.checked = false;
                return;
            }
            selectAllCheckbox.checked = visibleCheckboxes.every(cb => cb.checked);
        }

        function updateSelectionSummary() {
            const selectedCheckboxes = Array.from(tableBody.querySelectorAll('.item-checkbox:checked'));
            const count = selectedCheckboxes.length;
            
            if (count === 0) {
                selectionSummaryBar?.classList.add('d-none');
                return;
            }

            let totalQty = 0;
            let totalPrice = 0;

            selectedCheckboxes.forEach(cb => {
                const row = cb.closest('tr');
                const qty = parseFloat(row.querySelector('.recent-quantity')?.value || 0);
                const price = parseFloat(row.querySelector('.recent-manufacturing-price')?.value || 0);
                totalQty += qty;
                totalPrice += (qty * price);
            });

            if (selectedCountEl) selectedCountEl.textContent = count;
            if (selectedQuantityEl) selectedQuantityEl.textContent = totalQty.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
            if (selectedTotalPriceEl) selectedTotalPriceEl.textContent = totalPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            
            updateNetCalculation();
            updateFactoryBalanceDisplay();
            selectionSummaryBar?.classList.remove('d-none');
        }

        async function updateFactoryBalanceDisplay() {
            const selectedCbs = Array.from(tableBody.querySelectorAll('.item-checkbox:checked'));
            if (!selectedCbs.length) return;

            const firstMatch = selectedCbs[0].closest('tr');
            const factoryCode = firstMatch?.querySelector('.recent-factory-code')?.value.trim();
            
            if (!factoryCode) {
                if (currentFactoryBalanceEl) currentFactoryBalanceEl.textContent = '0.00';
                return;
            }

            try {
                const res = await fetch(`/api/factories/balance?code=${encodeURIComponent(factoryCode)}`);
                const data = await res.json();
                if (data.found && currentFactoryBalanceEl) {
                    currentFactoryBalanceEl.textContent = parseFloat(data.current_balance).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                }
            } catch (err) {
                console.error("Failed to fetch factory balance", err);
            }
        }

        function updateNetCalculation() {
            const total = parseFloat(selectedTotalPriceEl?.textContent.replace(/,/g, '') || 0);
            const deduction = parseFloat(deductionAmountInput?.value || 0);
            const net = total - deduction;
            if (netToPayEl) netToPayEl.textContent = net.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }
        async function confirmAccounting() {
            const selectedCbs = Array.from(tableBody.querySelectorAll('.item-checkbox:checked'));
            const selectedIds = selectedCbs.map(cb => cb.dataset.id);
            
            if (!selectedIds.length) return;

            // Get factory_code from first selected row (assuming all selected are for same factory)
            const firstRow = selectedCbs[0].closest('tr');
            const factoryCode = firstRow?.querySelector('.recent-factory-code')?.value.trim();
            const deductionAmount = parseFloat(deductionAmountInput?.value || 0);

            const date = normalizeDateValue(accountingDateInput?.value || '');
            if (!date) {
                showMessage('يرجى تحديد تاريخ المحاسبة.', 'warning');
                return;
            }

            if (!confirm(`هل أنت متأكد من محاسبة ${selectedIds.length} قصات؟ سيتم نقلها للأرشيف.`)) {
                return;
            }

            confirmButton.disabled = true;
            const originalHtml = confirmButton.innerHTML;
            confirmButton.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> جاري الحفظ...';

            try {
                const response = await fetch('/api/cut-items/mark-accounted', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        item_ids: selectedIds,
                        accounted_date: date,
                        deduction_amount: deductionAmount,
                        factory_code: factoryCode
                    })
                });
                const result = await response.json();
                if (!response.ok || !result.ok) throw new Error(result.message || 'فشلت عملية المحاسبة.');
                
                const printUrl = `/accounting-statement/${result.accounting_id}`;
                if (confirm(`${result.message}\n\nهل تود فتح كشف الحساب للطباعة الآن؟`)) {
                    window.open(printUrl, '_blank');
                }
                
                reloadPage(result.message);
            } catch (error) {
                showMessage(error.message, 'danger');
                confirmButton.disabled = false;
                confirmButton.innerHTML = originalHtml;
            }
        }

        function lookupFactoryCode(factoryName) {
            const normalizedName = (factoryName || '').trim().toLowerCase();
            const option = Array.from(factoryList?.options || []).find((item) => item.value.trim().toLowerCase() === normalizedName);
            return option ? (option.dataset.code || option.textContent || '').trim() : '';
        }

        function normalizeDateValue(text) {
            if (window.OperationDateUtils) {
                return window.OperationDateUtils.normalizeDateValue(text);
            }
            const value = (text || '').trim();
            if (!value) return '';
            if (/^\d{2}\/\d{2}\/\d{4}$/.test(value)) return value;
            if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
                const [year, month, day] = value.split('-');
                return `${day}/${month}/${year}`;
            }
            if (/^\d{2}-\d{2}-\d{4}$/.test(value)) {
                const [day, month, year] = value.split('-');
                return `${day}/${month}/${year}`;
            }
            return value;
        }

        function setRowEditable(row, editable) {
            row.querySelectorAll('.recent-basic-field').forEach((input) => {
                input.readOnly = !editable;
            });
            row.querySelectorAll('.recent-dispatch-field').forEach((input) => {
                input.readOnly = false;
            });
            row.classList.toggle('table-warning', editable);
        }

        async function saveRow(button) {
            const row = button.closest('tr[data-item-id]');
            const payload = {
                id: row.dataset.itemId,
                cut_date: normalizeDateValue(row.querySelector('.recent-cut-date')?.value.trim() || ''),
                message_no: row.querySelector('.recent-message-no')?.value.trim() || '',
                code: row.querySelector('.recent-code')?.value.trim().toUpperCase() || '',
                name: row.querySelector('.recent-name')?.value.trim() || '',
                size: row.querySelector('.recent-size')?.value.trim() || '',
                quantity: row.querySelector('.recent-quantity')?.value.trim() || '',
                description: row.querySelector('.recent-description')?.value.trim() || '',
                factory_code: row.querySelector('.recent-factory-code')?.value.trim().toUpperCase() || '',
                factory_name: row.querySelector('.recent-factory-name')?.value.trim() || '',
                manufacturing_price: row.querySelector('.recent-manufacturing-price')?.value.trim() || '',
                dispatch_date: normalizeDateValue(row.querySelector('.recent-dispatch-date')?.value.trim() || '')
            };

            button.disabled = true;
            const initialHtml = button.innerHTML;
            button.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            try {
                const response = await fetch('/api/cut-items/update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await response.json();
                if (!response.ok || !result.ok) {
                    throw new Error(result.message || 'تعذر حفظ تعديل السطر.');
                }
                reloadPage(`تم حفظ السطر ${row.dataset.itemId} بنجاح.`);
            } catch (error) {
                showMessage(error.message, 'danger');
            } finally {
                button.disabled = false;
                button.innerHTML = initialHtml;
            }
        }



        tableBody?.addEventListener('input', (event) => {
            const target = event.target;
            if (!(target instanceof HTMLInputElement)) return;
            if (target.classList.contains('recent-code') || target.classList.contains('recent-factory-code')) {
                target.value = target.value.toUpperCase();
            }
            if (target.classList.contains('recent-factory-name')) {
                const row = target.closest('tr');
                const codeInput = row?.querySelector('.recent-factory-code');
                const lookedUpCode = lookupFactoryCode(target.value);
                if (codeInput && lookedUpCode) {
                    codeInput.value = lookedUpCode.toUpperCase();
                }
            }
            if (target.classList.contains('recent-factory-code') || target.classList.contains('recent-factory-name') || target.classList.contains('recent-code')) {
                const row = target.closest('tr');
                const code = row?.querySelector('.recent-code')?.value.trim().toUpperCase() || '';
                const factoryCode = row?.querySelector('.recent-factory-code')?.value.trim().toUpperCase() || '';
                const priceInput = row?.querySelector('.recent-manufacturing-price');
                if (row && code && factoryCode && priceInput && !priceInput.value.trim()) {
                    fetch(`/api/prices/lookup?factory_code=${encodeURIComponent(factoryCode)}&product_code=${encodeURIComponent(code)}`)
                        .then((response) => response.json())
                        .then((payload) => {
                            if (payload.found && payload.item && priceInput && !priceInput.value.trim()) {
                                priceInput.value = payload.item.price_per_dozen ?? '';
                            }
                        })
                        .catch(() => {});
                }
            }
            if (target.classList.contains('recent-dispatch-date')) {
                target.value = normalizeDateValue(target.value);
            }
        });

        tableBody?.addEventListener('click', async (event) => {
            const row = event.target.closest('tr[data-item-id]');
            if (!row) return;
            if (event.target.closest('.edit-recent-item')) {
                setRowEditable(row, true);
                row.querySelector('.recent-cut-date')?.focus();
                return;
            }
            const saveButton = event.target.closest('.save-recent-item');
            if (saveButton) {
                await saveRow(saveButton);
                return;
            }
            const deleteButton = event.target.closest('.delete-recent-item');
            if (!deleteButton) return;
            if (!confirm('متأكد أنك تريد حذف هذا السطر؟')) return;
            deleteButton.disabled = true;
            try {
                const response = await fetch('/api/cut-items/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id: row.dataset.itemId })
                });
                const result = await response.json();
                if (!response.ok || !result.ok) {
                    throw new Error(result.message || 'تعذر حذف السطر.');
                }
                reloadPage(`تم حذف السطر ${row.dataset.itemId} بنجاح.`);
            } catch (error) {
                showMessage(error.message, 'danger');
            } finally {
                deleteButton.disabled = false;
            }
        });

        searchInput?.addEventListener('input', applySearch);
        searchInput?.addEventListener('keydown', (event) => {
            if (event.key === 'Enter') {
                event.preventDefault();
                applySearch();
            }
        });
        searchClearButton?.addEventListener('click', () => {
            if (searchInput) searchInput.value = '';
            applySearch();
            searchInput?.focus();
        });

        tableBody?.addEventListener('change', (e) => {
            if (e.target.classList.contains('item-checkbox')) {
                const checkedCheckboxes = Array.from(tableBody.querySelectorAll('.item-checkbox:checked'));
                
                if (e.target.checked && checkedCheckboxes.length > 1) {
                    const firstMatch = checkedCheckboxes[0].closest('tr');
                    const currentMatch = e.target.closest('tr');
                    const firstFactory = firstMatch?.querySelector('.recent-factory-code')?.value.trim();
                    const currentFactory = currentMatch?.querySelector('.recent-factory-code')?.value.trim();
                    
                    if (firstFactory !== currentFactory) {
                        e.target.checked = false; // Uncheck it
                        showMessage('لا يمكن تحديد أكثر من مصنع في نفس عملية التسوية. يرجى إنهاء المحاسبة الحالية أولاً.', 'warning');
                        return;
                    }
                }
                
                updateSelectAllState();
                updateSelectionSummary();
            }
        });

        selectAllCheckbox?.addEventListener('change', (e) => {
            const visibleRows = Array.from(tableBody.querySelectorAll('tr:not(.d-none):not(#manufacturerSearchEmptyRow)'));
            if (!visibleRows.length) {
                e.target.checked = false;
                return;
            }

            if (e.target.checked) {
                // Determine the factory code of the first visible row
                const firstRowFactory = visibleRows[0].querySelector('.recent-factory-code')?.value.trim();
                let selectedCount = 0;
                let crossFactoryFound = false;

                visibleRows.forEach(row => {
                    const cb = row.querySelector('.item-checkbox');
                    const rowFactory = row.querySelector('.recent-factory-code')?.value.trim();
                    if (cb) {
                        if (rowFactory === firstRowFactory) {
                            cb.checked = true;
                            selectedCount++;
                        } else {
                            cb.checked = false;
                            crossFactoryFound = true;
                        }
                    }
                });

                if (crossFactoryFound) {
                    showMessage('تم تحديد قصات المصنع الأول فقط. يمنع تحديد أكثر من مصنع معاً.', 'info');
                }
            } else {
                // Uncheck everything visible
                visibleRows.forEach(row => {
                    const cb = row.querySelector('.item-checkbox');
                    if (cb) cb.checked = false;
                });
            }
            updateSelectionSummary();
        });

        confirmButton?.addEventListener('click', confirmAccounting);
        deductionAmountInput?.addEventListener('input', updateNetCalculation);

        // --- QUICK REPORT LOGIC ---
        const quickReportBtn = document.getElementById('quickReportBtn');
        const quickReportModal = new bootstrap.Modal(document.getElementById('quickReportModal'));
        const quickReportContent = document.getElementById('quickReportContent');
        const printQuickReportBtn = document.getElementById('printQuickReportBtn');

        quickReportBtn?.addEventListener('click', () => {
            const selectedCbs = Array.from(tableBody.querySelectorAll('.item-checkbox:checked'));
            if (!selectedCbs.length) return;

            const firstRow = selectedCbs[0].closest('tr');
            const factoryName = firstRow?.querySelector('.recent-factory-name')?.value || '-';
            const factoryCode = firstRow?.querySelector('.recent-factory-code')?.value || '-';
            const factoryBalance = currentFactoryBalanceEl?.textContent || '0.00';
            const totalQty = selectedQuantityEl?.textContent || '0';
            const totalPrice = selectedTotalPriceEl?.textContent || '0.00';
            const deduction = deductionAmountInput?.value || '0.00';
            const net = netToPayEl?.textContent || '0.00';

            let itemsHtml = '';
            let grandTotal = 0;
            selectedCbs.forEach(cb => {
                const row = cb.closest('tr');
                const qty = parseFloat(row.querySelector('.recent-quantity')?.value || 0);
                const price = parseFloat(row.querySelector('.recent-manufacturing-price')?.value || 0);
                const rowTotal = qty * price;
                grandTotal += rowTotal;
                itemsHtml += `
                    <tr>
                        <td>${row.querySelector('.recent-message-no')?.value || ''}</td>
                        <td>${row.querySelector('.recent-code')?.value || ''}</td>
                        <td>${row.querySelector('.recent-name')?.value || ''}</td>
                        <td>${row.querySelector('.recent-size')?.value || ''}</td>
                        <td>${qty.toLocaleString('en-US', {minimumFractionDigits: 0})}</td>
                        <td>${price.toLocaleString('en-US', {minimumFractionDigits: 2})}</td>
                        <td class="fw-bold">${rowTotal.toLocaleString('en-US', {minimumFractionDigits: 2})}</td>
                    </tr>
                `;
            });

            const balanceNum = parseFloat(factoryBalance.replace(/,/g,'')) || 0;
            const deductionNum = parseFloat(deduction || 0);
            const balanceAfter = balanceNum - deductionNum;

            quickReportContent.innerHTML = `
                <div class="text-center mb-2">
                    <h4 class="fw-bold text-dark mb-0">${factoryName} <span class="text-muted fs-6">(${factoryCode})</span></h4>
                    <div class="text-muted small">تاريخ التقرير: ${new Date().toLocaleDateString('ar-EG')}</div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <div class="d-flex justify-content-between align-items-center px-3 py-1 bg-light rounded-3 border-start border-4 border-warning">
                            <span class="small text-muted">رصيد السلف السابق</span>
                            <span class="fw-bold text-warning">${factoryBalance} ج.م</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex justify-content-between align-items-center px-3 py-1 bg-light rounded-3 border-start border-4 border-danger">
                            <span class="small text-muted">الخصم المقترح</span>
                            <span class="fw-bold text-danger">${deductionNum.toLocaleString('en-US', {minimumFractionDigits: 2})} ج.م</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex justify-content-between align-items-center px-3 py-1 bg-light rounded-3 border-start border-4 border-dark">
                            <span class="small text-muted">الرصيد بعد الخصم المقترح</span>
                            <span class="fw-bold">${balanceAfter.toLocaleString('en-US', {minimumFractionDigits: 2})} ج.م</span>
                        </div>
                    </div>
                </div>

                <div class="table-responsive mb-3">
                    <table class="table table-bordered table-sm small mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>الرسالة</th>
                                <th>الكود</th>
                                <th>الصنف</th>
                                <th>المقاس</th>
                                <th>الكمية</th>
                                <th>السعر</th>
                                <th>الإجمالي</th>
                            </tr>
                        </thead>
                        <tbody>${itemsHtml}</tbody>
                        <tfoot class="fw-bold table-light">
                            <tr>
                                <td colspan="4" class="text-end">إجمالي الحساب:</td>
                                <td>${totalQty}</td>
                                <td>-</td>
                                <td>${grandTotal.toLocaleString('en-US', {minimumFractionDigits: 2})} ج.م</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="border rounded-3 overflow-hidden">
                    <div class="d-flex justify-content-between align-items-center px-4 py-2 bg-success bg-opacity-10 border-bottom border-success border-3">
                        <div class="fw-bold fs-5 text-success">الصافي للدفع</div>
                        <div class="fw-bold fs-4">${net} ج.م</div>
                    </div>
                    <div class="d-flex justify-content-between px-4 pt-3 pb-2">
                        <div class="text-center" style="width: 45%;">
                            <div class="fw-bold small mb-3">مراجعة المدير المالي</div>
                            <div style="border-bottom: 1px dotted #999; height: 1px;"></div>
                        </div>
                        <div class="text-center" style="width: 45%;">
                            <div class="fw-bold small mb-3">توقيع المستلم</div>
                            <div style="border-bottom: 1px dotted #999; height: 1px;"></div>
                        </div>
                    </div>
                </div>
            `;


            quickReportModal.show();
        });

        printQuickReportBtn?.addEventListener('click', () => {
            const printContent = quickReportContent.innerHTML;
            const win = window.open('', '_blank', 'width=1000,height=800');
            win.document.write(`
                <html lang="ar" dir="rtl">
                <head>
                    <title>تقرير سريع - معاينة تسوية</title>
                    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
                    <style>
                        body { font-family: Cairo, Arial; padding: 20px; direction: rtl; }
                        .report-header-preview { border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 30px; }
                        .bg-light { background-color: #f8f9fa !important; }
                        .border-start { border-right: 4px solid #0d6efd !important; border-left: 0 !important; }
                        .table { width: 100%; border-collapse: collapse; }
                        th { background-color: #f8f9fa; }
                    </style>
                </head>
                <body>${printContent}</body>
                </html>
            `);
            win.document.close();
            win.focus();
            setTimeout(() => { win.print(); win.close(); }, 500);
        });

        // --- GLOBAL PRINT INITIALIZATION ---
        const printManualTableButton = document.getElementById('printManualTableButton');

        window.OperationPrint.buildColumnChooser(
            'manufacturerCutsTable',
            'printColumnsPanel',
            'printColumnsOptions',
            'mfr_print_cols_selection'
        );

        // (تنبيه: تم نقل مستمع حدث الضغط على togglePrintColumnsButton إلى الأعلى مع منطق التذييل لتوحيد الإعدادات)

        // --- Checkbox state management ---
        const showTimeCheck = document.getElementById('printShowTimeCheck');
        const showPageNumCheck = document.getElementById('printShowPageNumbersCheck');
        
        if (showTimeCheck) {
            showTimeCheck.checked = localStorage.getItem('print_show_time') !== 'false';
            showTimeCheck.addEventListener('change', (e) => localStorage.setItem('print_show_time', e.target.checked));
        }
        if (showPageNumCheck) {
            showPageNumCheck.checked = localStorage.getItem('print_show_page_numbers') !== 'false';
            showPageNumCheck.addEventListener('change', (e) => localStorage.setItem('print_show_page_numbers', e.target.checked));
        }

        printManualTableButton?.addEventListener('click', () => {
            const showTime = showTimeCheck ? showTimeCheck.checked : true;
            const showPageNumbers = showPageNumCheck ? showPageNumCheck.checked : true;

            window.OperationPrint.printTable({
                tableId: 'manufacturerCutsTable',
                optionsId: 'printColumnsOptions',
                title: 'سجل قصات المصانع',
                enforcePrivacy: false, // Accounting page allows prices
                showTime: showTime,
                showPageNumbers: showPageNumbers,
                hideTitle: true // Hiding the hardcoded title
            });
        });

        Array.from(tableBody?.querySelectorAll('tr[data-item-id]') || []).forEach((row) => setRowEditable(row, false));

        // Archive Handlers
        document.querySelectorAll('.print-stmt-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const accountingId = btn.getAttribute('data-id');
                const pwd = prompt('كلمة مرور الإدارة لطباعة كشف الحساب:');
                if (pwd) {
                    window.location.href = `/accounting-statement/${accountingId}?pwd=${encodeURIComponent(pwd)}`;
                }
            });
        });

        document.querySelectorAll('.reverse-stmt-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const accountingId = btn.getAttribute('data-id');
                if (!confirm(`هل أنت متأكد من إلغاء وفك التسوية رقم ${accountingId}؟ \nسيؤدي هذا لإرجاع جميع القصات الموثقة بداخلها للحالة غير المحاسبة وحذف خصم السلفة الخاص بها!`)) return;
                
                const pwd = prompt('مطلوب كلمة مرور الإدارة لإلغاء التسوية:');
                if (!pwd) return;
                
                btn.disabled = true;
                const oldHtml = btn.innerHTML;
                btn.innerHTML = `<span class="spinner-border spinner-border-sm"></span>`;
                
                try {
                    const res = await fetch('/api/cut-items/reverse-accounting', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ accounting_id: accountingId, password: pwd })
                    });
                    const data = await res.json();
                    if (!res.ok || !data.ok) throw new Error(data.message || 'حدث خطأ.');
                    
                    alert(data.message);
                    location.reload();
                } catch (e) {
                    alert(e.message);
                    btn.disabled = false;
                    btn.innerHTML = oldHtml;
                }
            });
        });

        applySearch();
    })();
</script>
{% endblock %}
