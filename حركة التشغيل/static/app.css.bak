:root {
    --gray-100: #f8f9fa;
    --gray-200: #e9ecef;
    --gray-700: #495057;
}

body {
    font-family: "Cairo", "Segoe UI", Tahoma, sans-serif;
}

.table thead.sticky-top th {
    top: 0;
    z-index: 2;
}

.alert {
    padding: 0.55rem 0.85rem;
}

#inlineMessage:empty {
    display: none;
}

.form-control:focus {
    box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.2);
}

.date-input {
    direction: ltr;
    text-align: center;
}

.flatpickr-calendar {
    font-family: "Cairo", "Segoe UI", Tahoma, sans-serif;
}

.list-group-item {
    border-radius: 0.6rem;
    border: 1px solid var(--gray-200);
}

.recent-batch-card {
    padding: 0.75rem;
}

.recent-batch-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.55rem;
}

.recent-batch-report {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
}

.recent-batch-chip {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    background: #f8fafc;
    border: 1px solid #e3e9ef;
    border-radius: 999px;
    color: #5b6876;
    font-size: 0.75rem;
    padding: 0.2rem 0.65rem;
    white-space: nowrap;
}

/* السماح للحقول بالتمدد والتقلص مع عرض العمود بحرية كاملة */
.input-code,
.input-name,
.input-size,
.resizable-table td .form-control {
    min-width: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    text-overflow: ellipsis;
}

.print-columns-panel {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: 0.75rem;
    padding: 0.75rem;
}

.danger-zone {
    background: #fff5f5;
    border: 1px solid #f1aeb5;
    border-right: 5px solid #dc3545;
    border-radius: 0.9rem;
    padding: 1rem;
}

.compact-report {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: linear-gradient(135deg, #f7fafc 0%, #eef3f7 100%);
    border: 1px solid #dde5ec;
    border-radius: 0.9rem;
    padding: 0.7rem 1rem;
}

.compact-report-title {
    color: #4b5a6a;
    font-size: 0.88rem;
    font-weight: 700;
    white-space: nowrap;
}

.compact-report-items {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
}

.compact-report-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid #d8e0e7;
    border-radius: 999px;
    padding: 0.28rem 0.75rem;
}

.compact-report-label {
    color: #6c7a89;
    font-size: 0.78rem;
}

.compact-report-value {
    color: #16324f;
    font-size: 0.92rem;
    font-weight: 700;
}

@media (max-width: 768px) {
    .compact-report {
        align-items: flex-start;
        flex-direction: column;
    }

    .compact-report-items {
        width: 100%;
    }

    .recent-batch-head {
        align-items: flex-start;
        flex-direction: column;
    }
}

.resizable-table {
    table-layout: fixed !important;
    width: max-content; /* Allow the table to define its own width, which JS will control */
    min-width: unset !important;
    max-width: none !important;
}

.resizable-header {
    position: relative;
    min-width: 40px;
}

.resize-handle {
    position: absolute;
    left: 0;
    top: 0;
    width: 6px;
    height: 100%;
    cursor: col-resize;
    user-select: none;
}

.resize-handle:hover,
.resize-handle:active {
    background-color: rgba(13, 110, 253, 0.35);
}
